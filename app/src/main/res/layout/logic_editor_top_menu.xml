<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="?attr/colorSurface"
    android:gravity="center_vertical|end"
    android:orientation="horizontal"
    android:paddingVertical="4dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- Delete: neutral by default, red accent when active. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageButton
            android:id="@+id/iv_trash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:contentDescription="@string/auto6_content_desc_delete"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_mtrl_delete"
            android:tint="?attr/colorOnSurfaceVariant" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Duplicate: neutral by default, teal accent when active. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_copy"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageButton
            android:id="@+id/iv_copy"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:contentDescription="@string/auto6_content_desc_duplicate"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/abc_ic_menu_copy_mtrl_am_alpha"
            android:tint="?attr/colorOnSurfaceVariant" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Bookmark/collection: always accented red, like the mockup. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_favorite"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageButton
            android:id="@+id/iv_bookmark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:contentDescription="@string/auto6_content_desc_collection"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_mtrl_bookmark"
            android:tint="?attr/colorError" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Details: neutral by default, violet accent when active. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_detail"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageButton
            android:id="@+id/iv_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:contentDescription="@string/auto6_content_desc_detail"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_mtrl_block"
            android:tint="?attr/colorOnSurfaceVariant" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
