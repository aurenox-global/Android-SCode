<resources>
    <!--
      I decided that new or modified styles will be stored here.
      If you change the style of a component from styles.xml, please MOVE (not copy) that style here.

      So, contributors, can you follow the following "guidelines" xD:
      — 'Theme|ThemeOverlay|Widget|TextAppearance|ShapeAppearanceOverlay' -
           this prefix must always be included first
      — 'Ascode' - remains unchanged, as the name of the app speaks for itself.
      — '*' - instead of using the asterisk (*), replace it with the specific name of the component whose style is being modified or created.
    -->

    <style name="Widget.Ascode.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Ascode.CollapsingToolbar" parent="Widget.Material3Expressive.CollapsingToolbar.Large">
        <item name="collapsedTitleTextAppearance">
            @style/TextAppearance.Ascode.CollapsingToolbar.Collapsed
        </item>
        <item name="expandedTitleTextAppearance">
            @style/TextAppearance.Ascode.CollapsingToolbar.Expanded
        </item>
        <item name="titleCollapseMode">scale</item>
    </style>

    <style name="TextAppearance.Ascode.CollapsingToolbar.Collapsed" parent="TextAppearance.Ascode.TitleLarge" />
    <style name="TextAppearance.Ascode.CollapsingToolbar.Expanded" parent="TextAppearance.Ascode.HeadlineMedium" />

    <style name="Widget.Ascode.Toolbar.SmallText" parent="Widget.Material3Expressive.Toolbar.OnSurface">
        <item name="titleTextAppearance">?attr/textAppearanceBodyLarge</item>
    </style>

    <style name="Widget.Ascode.NavigationView.Main" parent="Widget.Material3.NavigationView">
        <item name="dividerInsetEnd">@dimen/main_drawer_horizontal_padding</item>
        <item name="dividerInsetStart">@dimen/main_drawer_horizontal_padding</item>
        <item name="itemHorizontalPadding">@dimen/main_drawer_horizontal_padding</item>
        <item name="itemIconPadding">@dimen/main_drawer_icon_padding</item>
        <item name="itemShapeInsetEnd">@dimen/main_drawer_shape_horizontal_inset</item>
        <item name="itemShapeInsetStart">@dimen/main_drawer_shape_horizontal_inset</item>
        <item name="itemTextAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="subheaderInsetEnd">@dimen/main_drawer_horizontal_padding</item>
        <item name="subheaderInsetStart">@dimen/main_drawer_horizontal_padding</item>
    </style>

    <style name="Widget.Ascode.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Medium</item>
    </style>

    <style name="Widget.Ascode.TextInputLayout.ExposedDropdownMenu" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Medium</item>
    </style>

    <style name="ThemeOverlay.Ascode.ViewEditor" parent="Base.Theme.MaterialComponents.Light" />

    <style name="ThemeOverlay.Ascode.ViewEditor.Material3.Light" parent="ThemeOverlay.Material3.DynamicColors.Light" />

    <style name="ThemeOverlay.Ascode.ViewEditor.Material3.Dark" parent="ThemeOverlay.Material3.DynamicColors.Dark" />

    <style name="ThemeOverlay.Ascode.ViewEditor.Material3.NON_DYNAMIC.Light" parent="Base.Theme.Material3.Light" />

    <style name="ThemeOverlay.Ascode.ViewEditor.Material3.NON_DYNAMIC.Dark" parent="Base.Theme.Material3.Dark" />

    <style name="Preference.Ascode.SwitchPreferenceCompat" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="widgetLayout">@layout/preference_widget_layout_m3_switch</item>
    </style>

    <style name="Widget.Ascode.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicator">@drawable/view_tab_indicator</item>
    </style>

    <style name="ThemeOverlay.Ascode.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/Widget.Ascode.BottomSheet.Modal</item>
    </style>

    <style name="ShapeAppearance.Ascode.AsymmetricCard" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">4dp</item>
        <item name="cornerSizeBottomRight">24dp</item>
        <item name="cornerSizeBottomLeft">4dp</item>
    </style>

    <style name="ShapeAppearance.Ascode.AsymmetricDialog" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">4dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomRight">28dp</item>
        <item name="cornerSizeBottomLeft">28dp</item>
    </style>

    <style name="ShapeAppearance.Ascode.AsymmetricInput" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">4dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomRight">20dp</item>
        <item name="cornerSizeBottomLeft">4dp</item>
    </style>

    <style name="Widget.Ascode.CardView.Asymmetric" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearance">@style/ShapeAppearance.Ascode.AsymmetricCard</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="Widget.Ascode.TextInputLayout.Asymmetric" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.Ascode.AsymmetricInput</item>
    </style>

    <style name="Widget.Ascode.BottomSheet.Modal" parent="Widget.Material3.BottomSheet">
        <item name="android:elevation">0dp</item>
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>

    <style name="ThemeOverlay.Ascode.AlertDialog" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog.Centered">
        <item name="android:colorBackground">?attr/colorSurfaceContainer</item>
        <item name="android:windowAnimationStyle">@style/MaterialAlertDialog.Material3.Animation
        </item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowMinWidthMajor">65%</item>
        <item name="android:windowMinWidthMinor">98%</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Ascode</item>

        <!-- Expressive button styles have increased horizontal padding, which we don't need at all. -->
        <item name="buttonBarButtonStyle">@style/Widget.Material3.Button.TextButton.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Material3.Button.TextButton.Dialog
        </item>
        <item name="buttonBarNeutralButtonStyle">
            @style/Widget.Material3.Button.TextButton.Dialog.Flush
        </item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Material3.Button.TextButton.Dialog
        </item>
    </style>

    <style name="MaterialAlertDialog.Ascode" parent="MaterialAlertDialog.Material3Expressive">
        <item name="backgroundInsetBottom">8dp</item>
        <item name="backgroundInsetTop">8dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.ExtraLarge</item>
    </style>

    <style name="Widget.Ascode.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
    </style>

    <style name="Widget.Ascode.Chip" parent="Widget.Material3.Chip.Input.Icon.Elevated">
        <item name="closeIconEnabled">false</item>
        <item name="closeIcon">@null</item>
        <item name="checkedIconEnabled">true</item>
        <item name="checkedIconTint">?attr/colorOnSecondary</item>
        <item name="checkedIcon">@drawable/ic_mtrl_done</item>
        <item name="chipBackgroundColor">?attr/colorSecondary</item>
        <item name="chipCornerRadius">90dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Ascode.Chip</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
    </style>

    <style name="Widget.Ascode.Chip.ProjectPreview" parent="Widget.Material3.Chip.Suggestion">
        <item name="android:focusable">false</item>
        <item name="android:clickable">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">@null</item>
        <item name="shapeAppearance">?attr/shapeAppearanceCornerLarge</item>
    </style>

    <style name="TextAppearance.Ascode.Chip" parent="TextAppearance.Ascode.BodyMedium">
    </style>

    <style name="TextAppearance.Ascode.BodyLargeEmphasized" parent="TextAppearance.Ascode.BodyLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.Ascode.Chip.ProjectPreview" parent="">
        <item name="chipStyle">@style/Widget.Ascode.Chip.ProjectPreview</item>
    </style>
    <!-- Theme used by AsdDialog to fix keyboard visibility for find/replace -->
    <style name="AsdEditorDialogTheme" parent="Theme.Ascode">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">stateVisible|adjustResize</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
