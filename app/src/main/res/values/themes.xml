<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Ascode" parent="Scheme.Ascode.DayNight" />
    <style name="Theme.Ascode" parent="Platform.Theme.Ascode">
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="bottomNavigationStyle">@style/Widget.Ascode.BottomNavigationView</item>
        <item name="chipStyle">@style/Widget.Ascode.Chip</item>
        <item name="collapsingToolbarLayoutStyle">?attr/collapsingToolbarLayoutLargeStyle</item>
        <item name="collapsingToolbarLayoutLargeSize">@dimen/collapsing_toolbar_large_size</item>
        <item name="collapsingToolbarLayoutLargeStyle">@style/Widget.Ascode.CollapsingToolbar</item>
        <item name="homeAsUpIndicator">@drawable/abc_ic_ab_back_material</item>
        <item name="textInputStyle">@style/Widget.Ascode.TextInputLayout</item>
        <item name="switchPreferenceCompatStyle">
            @style/Preference.Ascode.SwitchPreferenceCompat
        </item>
        <item name="tabStyle">@style/Widget.Ascode.TabLayout</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Ascode.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Ascode.AlertDialog</item>
        <item name="popupMenuStyle">@style/Widget.Material3.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.Material3.PopupMenu</item>
        <item name="materialCardViewStyle">?attr/materialCardViewFilledStyle</item>
        <item name="materialCardViewFilledStyle">@style/Widget.Ascode.CardView</item>
        <!-- Type styles. -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Ascode.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Ascode.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Ascode.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Ascode.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Ascode.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Ascode.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Ascode.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Ascode.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Ascode.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Ascode.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Ascode.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Ascode.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Ascode.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Ascode.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Ascode.LabelSmall</item>
        <item name="textAppearanceBodyLargeEmphasized">@style/TextAppearance.Ascode.BodyLargeEmphasized</item>
    </style>

    <style name="Theme.Ascode.Main">
        <item name="navigationViewStyle">@style/Widget.Ascode.NavigationView.Main</item>
        <item name="materialCardViewFilledStyle">@style/Widget.Ascode.CardView.Asymmetric</item>
    </style>

    <style name="Theme.Ascode.ProjectPreview">
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Ascode.BottomSheetDialog
        </item>
    </style>

    <style name="Theme.Ascode.SmallToolbar">
        <item name="actionBarSize">@dimen/mtrl_toolbar_default_height</item>
        <item name="toolbarStyle">@style/Widget.Ascode.Toolbar.SmallText</item>
    </style>

    <style name="Theme.Ascode.Starting.Base" parent="Theme.SplashScreen">
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="windowSplashScreenAnimationDuration">850</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenBackground">@color/splash_bg_color</item>
        <item name="postSplashScreenTheme">@style/Theme.Ascode.Main</item>

        <item name="android:navigationBarColor">@color/splash_bg_color</item>
        <item name="android:statusBarColor">@color/splash_bg_color</item>
        <item name="android:windowLightStatusBar">@bool/is_light_theme</item>
        <item name="android:windowLightNavigationBar">@bool/is_light_theme
        </item>
    </style>

    <style name="Theme.Ascode.Starting" parent="Theme.Ascode.Starting.Base" />

    <style name="Platform.V21.Theme.Ascode" parent="Base.Theme.Ascode">
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>
    <style name="Platform.Theme.Ascode" parent="Platform.V21.Theme.Ascode" />
</resources>
